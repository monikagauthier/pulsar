# ============================================================
# PULSAR — variáveis de ambiente (exemplo)
# Copie para `.env.local` e preencha conforme a necessidade.
# NÃO versione o arquivo .env.local.
# ============================================================

# URL pública do site (usada em metadados e links absolutos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics (opcional) ---
# NEXT_PUBLIC_ANALYTICS_ID=""

# --- Integração de inscrição / pagamento (futuro) ---
# Checkout externo (ex.: link ou provedor de pagamento)
# NEXT_PUBLIC_CHECKOUT_URL=""

# --- Captura de leads / e-mail (futuro) ---
# Endpoint ou chave de serviço de e-mail (mantenha no servidor, sem NEXT_PUBLIC_)
# EMAIL_API_KEY=""
# EMAIL_FROM="contato@pulsar.example"

# --- Formulário de contato (futuro) ---
# CONTACT_WEBHOOK_URL=""
